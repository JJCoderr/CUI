          <Reorder Name="tasks" OnChanged="toast:order" If="page == 7">
            <ReorderItem>
              <Text Width="fill" Nowrap="true">Write the release notes</Text>
              <Badge Text="Docs" Tone="info"/>
            </ReorderItem>
            <ReorderItem>
              <Text Width="fill" Nowrap="true">Record the demo video</Text>
              <Badge Text="Video"/>
            </ReorderItem>
            <ReorderItem>
              <Text Width="fill" Nowrap="true">Update the screenshots</Text>
              <Badge Text="Docs" Tone="info"/>
            </ReorderItem>
            <ReorderItem>
              <Text Width="fill" Nowrap="true">Tag version 1.0</Text>
              <Badge Text="Release" Tone="warning"/>
            </ReorderItem>
            <ReorderItem>
              <Text Width="fill" Nowrap="true">Post the announcement</Text>
              <Badge Text="Blog" Tone="teal"/>
            </ReorderItem>
          </Reorder>
          <Column Gap="4" PadTop="18" If="page == 7">
            <Heading Level="4">Accordion</Heading>
          </Column>
          <Card PadY="4" Gap="0" If="page == 7">
            <Accordion Text="Is it really dependency free?" Bind="acc0" Open="true">
              <Secondary>Yes. The core is plain C99. Windows uses Win32, macOS uses Cocoa and Linux uses X11. Fonts and icons are embedded.</Secondary>
            </Accordion>
            <Accordion Text="Can I use my own renderer?" Bind="acc1">
              <Secondary>CUI outputs vertices and draw commands. Port the 60 line shader to Vulkan, Metal or Direct3D and you are done.</Secondary>
            </Accordion>
            <Accordion Text="Does it respect reduced motion?" Bind="acc2">
              <Secondary>Every animation has a reduced motion path that keeps the final state and feedback.</Secondary>
            </Accordion>
          </Card>
          <Column Gap="4" PadTop="18" If="page == 7">
            <Heading Level="4">Virtual list</Heading>
            <Secondary>Ten thousand rows. Only the visible ones are built.</Secondary>
          </Column>
          <Card Pad="6" If="page == 7">
            <Invoices Name="big"/>
          </Card>

          <!-- ============================== charts ============================ -->
          <Column Gap="4" PadTop="18" If="page == 8">
            <Heading Level="4">Line chart</Heading>
            <Secondary>Hover to inspect values. The crosshair glides between points.</Secondary>
          </Column>
          <Card If="page == 8">
            <LineChart Name="revenue" Height="240" Area="true" Smooth="true" Format="$%.0fk"
                       Labels="Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec">
              <Series Text="Revenue" Values="18,22,21,27,31,29,36,41,39,46,52,58"/>
              <Series Text="Costs" Values="12,13,15,14,18,19,21,22,24,25,27,29"/>
            </LineChart>
          </Card>
          <Box Direction="grid" Columns="2" MinColumnWidth="260" Gap="16" If="page == 8">
            <Column Gap="12">
              <Column Gap="4" PadTop="18">
                <Heading Level="4">Bar chart</Heading>
              </Column>
              <Card>
                <BarChart Name="visits" Height="200" Labels="Jan|Feb|Mar|Apr|May|Jun">
                  <Series Text="Desktop" Values="42,51,38,64,58,71"/>
                  <Series Text="Mobile" Values="28,33,30,41,46,49"/>
                </BarChart>
              </Card>
            </Column>
            <Column Gap="12">
              <Column Gap="4" PadTop="18">
                <Heading Level="4">Donut chart</Heading>
              </Column>
              <Card Align="center">
                <DonutChart Name="platforms" Height="180" Format="%.0f%%">
                  <Slice Text="Windows" Value="46"/>
                  <Slice Text="macOS" Value="27"/>
                  <Slice Text="Linux" Value="17"/>
                  <Slice Text="Other" Value="10"/>
                </DonutChart>
              </Card>
            </Column>
          </Box>
          <Column Gap="4" PadTop="18" If="page == 8">
            <Heading Level="4">Dither area chart</Heading>
            <Secondary>Fills made of dots that thin out toward the base; stacked bands keep their own color.</Secondary>
          </Column>
          <Card If="page == 8">
            <LineChart Name="requests" Height="220" Dither="true" Stacked="true" Smooth="true" Format="%.0fk"
                       Labels="00:00|02:00|04:00|06:00|08:00|10:00|12:00|14:00|16:00|18:00|20:00|22:00">
              <Series Text="API" Color="series4" Values="22,19,17,21,30,38,41,37,34,39,33,26"/>
              <Series Text="Web" Color="series1" Values="18,15,13,16,24,33,36,40,38,42,35,28"/>
            </LineChart>
          </Card>
          <Column Gap="4" PadTop="18" If="page == 8">
            <Heading Level="4">Pattern meter</Heading>
            <Secondary>Each part has a color and a density, so it reads in grayscale too. Hover a part or a legend entry.</Secondary>
          </Column>
          <Card Gap="24" If="page == 8">
            <PatternMeter Name="storage" Total="256" Label="Storage" Unit="GB" Grayscale="{grayscale}">
              <Part Text="Photos" Value="81"/>
              <Part Text="Video" Value="58"/>
              <Part Text="Apps" Value="41"/>
              <Part Text="Docs" Value="32"/>
            </PatternMeter>
            <Checkbox Text="Grayscale" Bind="grayscale"/>
          </Card>
          <Column Gap="4" PadTop="18" If="page == 8">
            <Heading Level="4">Stacked bars and gauges</Heading>
          </Column>
          <Box Direction="grid" Columns="2" MinColumnWidth="260" Gap="16" If="page == 8">
            <Card>
              <BarChart Name="runs" Height="200" Stacked="true" Labels="W1|W2|W3|W4|W5|W6|W7|W8">
                <Series Text="Passed" Values="112,124,131,128,140,152,149,161"/>
                <Series Text="Retried" Values="9,11,8,12,10,9,13,8"/>
                <Series Text="Failed" Values="4,6,3,5,7,4,6,3"/>
              </BarChart>
            </Card>
            <Card Dir="row" Gap="24" Align="center">
              <Gauge Label="CPU" Value="0.42" Size="130"/>
              <Gauge Label="Memory" Value="0.81" Size="130"/>
            </Card>
          </Box>

        </Column>
      </Row>
    </Scroll>
  </Row>
</Window>
