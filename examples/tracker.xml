<?xml version="1.0" encoding="utf-8"?>
<!--
  examples/tracker.c, described in a file.

  The board is the app's data: examples/tracker_xml.c keeps the ten issues with
  their key, title, owner, due date, status, priority and two labels, the five
  status names and the five priority names, the selected issue, the comment
  field, the subscribed bell and which panes a window's width asks for. The rows
  of the list are <Issues>, a tag registered in that file: which group holds
  which issue, the count beside a group and the shape of a row (two painted
  glyphs, and a canvas painted behind the row so it can show its selection) are
  the app's data too. <StatusGlyph> and <PriorityGlyph> are the two painted
  marks the detail pane shows, <Drawer> and <DetailSheet> the two sheets a
  narrow window opens, and the command palette is drawn after the document
  because its commands are the app's data.

  Everything about the window, the sidebar, the list's header and tabs, the
  detail pane's properties and activity, and the comment row is here. The
  sidebar is written once as a <Widget> because the pane and the sheet use it: a
  sheet fills its width, has no background of its own and no padding.

  `panes` is the one fact of the window's width, worked out in C every frame:
  three panes over 1200 points, two over 760, one below. `wide` and `three` are
  that answer for the two dividers.

  The two programs seed the same board, so their shot output is compared byte
  for byte.
-->
<Window Title="Orbit" Width="1440" Height="900" Theme="dark" Accent="neutral"
        Background="background">

  <Shortcut Keys="Ctrl+K" Action="palette"/>

  <!-- the sidebar: the brand, the three groups of places, the cycle, the account -->
  <Widget Name="Sidebar" Drawer="0">
    <Column Width="{Drawer ? 'fill' : '240'}" Height="fill"
            Background="{Drawer ? 'transparent' : 'surfaceMuted'}"
            Pad="{Drawer ? 0 : 12}" Gap="2">

      <Row Gap="10" PadX="6" PadTop="4" PadBottom="12" Align="center">
        <Stack Width="26" Height="26" Radius="8" Background="accent" Align="center"
               Justify="center">
          <Icon Icon="target" Size="16" Color="accentForeground"/>
        </Stack>
        <Text Font="medium" Size="15" Width="fill" Nowrap="true">Orbit</Text>
        <IconButton Icon="square-pen" Size="sm" Tooltip="New issue"/>
      </Row>

      <NavItem Icon="inbox" Badge="4" Selected="{nav == 0}" Group="nav"
               OnClicked="nav:0">Inbox</NavItem>
      <NavItem Icon="circle-user" Selected="{nav == 1}" Group="nav"
               OnClicked="nav:1">My issues</NavItem>
      <NavItem Icon="layers" Selected="{nav == 2}" Group="nav"
               OnClicked="nav:2">Views</NavItem>

      <Box Height="12"/>
      <NavSection>Workspace</NavSection>
      <NavItem Icon="box" Selected="{nav == 3}" Group="nav"
               OnClicked="nav:3">Projects</NavItem>
      <NavItem Icon="refresh-cw" Selected="{nav == 4}" Group="nav"
               OnClicked="nav:4">Cycles</NavItem>
      <NavItem Icon="map-pin" Selected="{nav == 5}" Group="nav"
               OnClicked="nav:5">Roadmap</NavItem>

      <Box Height="12"/>
      <NavSection>Teams</NavSection>
      <NavItem Icon="cpu" Selected="{nav == 6}" Group="nav"
               OnClicked="nav:6">Engine</NavItem>
      <NavItem Icon="palette" Selected="{nav == 7}" Group="nav"
               OnClicked="nav:7">Design</NavItem>
      <NavItem Icon="server" Selected="{nav == 8}" Group="nav"
               OnClicked="nav:8">Platform</NavItem>

      <Spacer/>

      <!-- how far the cycle is -->
      <Card Pad="14" Gap="10">
        <Row Gap="8" Align="center">
          <Icon Icon="zap" Size="14" Color="accent"/>
          <Text Font="medium" Size="13" Width="fill">Cycle 24</Text>
          <Text Size="12" Color="textMuted">6 days left</Text>
        </Row>
        <Progress Value="0.64" Height="6"/>
        <Text Size="12" Color="textSecondary">32 of 50 issues done</Text>
      </Card>

      <Box Height="8"/>
      <Row Gap="10" PadX="6" PadY="4" Align="center">
        <Avatar Size="28" Status="online">Maya Okafor</Avatar>
        <Column Gap="0" Width="fill">
          <Text Font="medium" Size="13" Nowrap="true">Maya Okafor</Text>
          <Text Size="12" Color="textMuted" Nowrap="true">maya@orbit.dev</Text>
        </Column>
        <IconButton Icon="settings" Size="sm" Tooltip="Settings"/>
      </Row>

    </Column>
  </Widget>

  <!-- the pane on the left, the list, and the issue open on the right -->
  <Row Width="fill" Height="fill" Align="stretch" Background="background">
    <Sidebar If="{wide}"/>
    <Separator If="{wide}"/>

    <Column Width="fill" Height="fill">

      <!-- where the list is, and what can be done to it -->
      <Row Width="fill" PadX="{phone ? 12 : 24}" PadY="14" Gap="{phone ? 6 : 12}"
           Align="center">
        <IconButton If="{phone}" Icon="menu" Tooltip="Menu" OnClicked="drawer"/>
        <Breadcrumb Items="Engine|Issues"/>
        <Spacer/>
        <IconButton If="{phone}" Icon="filter" Tooltip="Filter"/>
        <IconButton If="{phone}" Icon="plus" Variant="primary" Size="sm"
                    Tooltip="New issue"/>
        <Button If="{!phone}" Text="Filter" Icon="filter" Size="sm" Variant="ghost"/>
        <Button If="{!phone}" Text="Display" Icon="sliders-horizontal" Size="sm"
                Variant="ghost"/>
        <Button If="{!phone}" Text="New issue" Icon="plus" Size="sm" Variant="primary"/>
      </Row>

      <!-- the saved views, and who is on the team -->
      <Row Width="fill" PadX="{phone ? 12 : 24}" PadBottom="12" Align="center">
        <Tabs Name="views" Items="All issues|Active|Backlog" Bind="tab" Variant="pill"/>
        <Spacer/>
        <AvatarGroup Items="Maya Okafor|Jonas Berg|Priya Nair|Lena Fischer|Aiko Tanaka"
                     Max="4" Size="24"/>
      </Row>

      <Separator/>

      <!-- the four groups of issues, <Issues> draws them in the app's order -->
      <Scroll Name="issues" Pad="{phone ? 4 : 12}" Gap="2" Fade="true">
        <Issues/>
      </Scroll>

    </Column>

    <Separator If="{three}"/>
    <Detail If="{three}" InSheet="0"/>
  </Row>

  <!-- the issue open on the right: its key, the bell and the menu, then the
       properties, the activity and the comment field -->
  <Widget Name="Detail" InSheet="0">
    <Column Width="{InSheet ? 'fill' : '380'}" Height="fill"
            Background="{InSheet ? 'transparent' : 'surface'}">

      <Row If="{!InSheet}" Width="fill" PadX="20" PadY="14" Gap="6" Align="center">
        <Text Font="mono" Size="12" Color="textSecondary">{issueKey}</Text>
        <CopyButton Name="copy" Copy="{issueKey}"/>
        <Spacer/>
        <IconButton Icon="bell" Size="sm" Tooltip="{subscribed ? 'Unsubscribe' : 'Subscribe'}"
                    OnClicked="subscribe"/>
        <Menu Text="More" Icon="ellipsis" IconOnly="true" Variant="ghost"
              Placement="bottomend">
          <MenuItem Text="Copy link" Icon="link" Shortcut="Ctrl L"/>
          <MenuItem Text="Duplicate" Icon="copy"/>
          <MenuSeparator/>
          <MenuItem Text="Delete issue" Icon="trash-2" Danger="true"/>
        </Menu>
      </Row>

      <Separator If="{!InSheet}"/>

      <Scroll Name="detail" Pad="{InSheet ? 0 : 20}" Gap="18" Fade="true">
        <Text Font="display" Size="20" LineHeight="1.3">{issueTitle}</Text>
        <Text Color="textSecondary">Typing quickly into a focused field sometimes loses the final keystroke when the frame that receives it also changes focus. Repro: type and press Tab in the same frame.</Text>

        <!-- what the issue is: status, priority, who has it, its labels -->
        <Column Gap="12" Width="fill">
          <Row Gap="8" Align="center">
            <Text Size="13" Color="textSecondary" Width="96" Nowrap="true">Status</Text>
            <StatusGlyph Status="{issueStatus}"/>
            <Text Size="13">{issueStatusName}</Text>
          </Row>
          <Row Gap="8" Align="center">
            <Text Size="13" Color="textSecondary" Width="96" Nowrap="true">Priority</Text>
            <PriorityGlyph Priority="{issuePriority}"/>
            <Text Size="13">{issuePriorityName}</Text>
          </Row>
          <Row Gap="8" Align="center">
            <Text Size="13" Color="textSecondary" Width="96" Nowrap="true">Assignee</Text>
            <Avatar Size="20">{issueAssignee}</Avatar>
            <Text Size="13">{issueAssignee}</Text>
          </Row>
          <Row Gap="6" Align="center">
            <Text Size="13" Color="textSecondary" Width="96" Nowrap="true">Labels</Text>
            <Badge Text="{issueLabel1}" Tone="{issueLabel1Tone}"/>
            <Badge If="{!empty(issueLabel2)}" Text="{issueLabel2}" Tone="{issueLabel2Tone}"/>
          </Row>
          <Row Gap="8" Align="center">
            <Text Size="13" Color="textSecondary" Width="96" Nowrap="true">Cycle</Text>
            <Icon Icon="refresh-cw" Size="14" Color="textSecondary"/>
            <Text Size="13">Cycle 24</Text>
          </Row>
          <Row Gap="8" Align="center">
            <Text Size="13" Color="textSecondary" Width="96" Nowrap="true">Due date</Text>
            <Icon Icon="calendar" Size="14" Color="textSecondary"/>
            <Text Size="13">{issueDate}</Text>
          </Row>
        </Column>

        <Separator/>
        <Label>Activity</Label>
        <Column Gap="0" Width="fill">
          <TimelineItem Time="2h ago" Icon="arrow-right" Tone="warning">Maya moved this to In progress</TimelineItem>
          <TimelineItem Time="5h ago" Icon="git-branch" Tone="accent"
                        Description="Keep pending text across focus changes">Jonas linked a pull request</TimelineItem>
          <TimelineItem Time="Yesterday" Icon="circle-alert" Tone="warning">Priya set the priority to Urgent</TimelineItem>
          <TimelineItem Time="Nov 2" Icon="plus" Last="true">Issue created</TimelineItem>
        </Column>
      </Scroll>

      <Separator/>
      <Row Width="fill" Pad="{InSheet ? 0 : 16}" PadTop="16" Gap="8" Align="center">
        <Input Name="comment" Bind="comment" Placeholder="Leave a comment" Width="fill"/>
        <IconButton Icon="send" Variant="primary" Tooltip="Send"/>
      </Row>

    </Column>
  </Widget>

  <!-- on a phone the sidebar is a drawer, and the issue opens in a sheet -->
  <Drawer Text="Orbit" Side="left" Size="280">
    <Sidebar Drawer="1"/>
  </Drawer>

  <DetailSheet>
    <Detail InSheet="1"/>
  </DetailSheet>

</Window>
